# Server
PORT=4000
MONGODB_URI=mongodb://localhost:27017/hms
JWT_SECRET=your-jwt-secret
CORS_ORIGIN=http://localhost:5173

# Hospital display name (used in email/WhatsApp templates)
HOSPITAL_NAME=My Hospital

# ---- Email (SMTP) ----
# Paste your SMTP credentials. Gmail: use App Password; Outlook/Office365: use SMTP settings.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@myhospital.com
# Set to true if using port 465 (SSL)
EMAIL_SECURE=false

# ---- WhatsApp (Twilio) ----
# 1. Sign up at https://www.twilio.com
# 2. Get Account SID and Auth Token from Twilio Console
# 3. For testing: use Twilio Sandbox (WhatsApp) - you get a number like +14155238886
# 4. For production: use your WhatsApp Business number (e.g. +919876543210)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Sandbox: whatsapp:+14155238886  |  Production: whatsapp:+919876543210
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Feature flags (optional, default: true) ----
# Set to false to disable a channel for a notification type
NOTIFY_APPOINTMENT_EMAIL=true
NOTIFY_APPOINTMENT_WHATSAPP=true
NOTIFY_PRESCRIPTION_EMAIL=true
NOTIFY_PRESCRIPTION_WHATSAPP=true
NOTIFY_LEAVE_REQUEST_EMAIL=true
